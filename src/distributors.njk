                                                <div class="block-buy__slide swiper-slide">
                                                    <img loading="lazy" src="img/shop5.webp" alt="">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="block-buy__pagination pagination"></div>
                                    </div>
                                    <div class="block-buy__item">
                                        <div class="block-buy__titles">
                                            <div class="block-buy__title">
                                                DMITRIEV green house
                                            </div>
                                            <p>
                                                Краснодар, пос. Плодородный, 14/1
                                            </p>
                                        </div>
                                        <a href="./" data-popup="#request" class="btn">
                                            <span>Оставить заявку</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="block-buy__card">
                                    <div class="block-buy__image">
                                        <div class="block-buy__slider swiper">
                                            <div class="block-buy__wrapper swiper-wrapper">
                                                <div class="block-buy__slide swiper-slide">
                                                    <img loading="lazy" src="img/shop6.webp" alt="">
                                                </div>
                                                <div class="block-buy__slide swiper-slide">
                                                    <img loading="lazy" src="img/shop6.webp" alt="">
                                                </div>
                                                <div class="block-buy__slide swiper-slide">
                                                    <img loading="lazy" src="img/shop6.webp" alt="">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="block-buy__pagination pagination"></div>
                                    </div>
                                    <div class="block-buy__item">
                                        <div class="block-buy__titles">
                                            <div class="block-buy__title">
                                                МАРТФЛО
                                            </div>
                                            <p>
                                                Краснодар, Ростовское шоссе, 22/2
                                            </p>
                                        </div>
                                        <a href="./" data-popup="#request" class="btn">
                                            <span>Оставить заявку</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-forms block1">
                <div class="container">
                    <div class="block-forms__content">
                        <form action="#" class="form">
                            <div class="form__top">
                                <h2 class="title2">
                                    Стать дистрибьютором
                                </h2>
                                <p>
                                    Оставьте заявку — менеджер свяжется в течение 2 часов
                                </p>
                            </div>
                            <div class="form__inputs">
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="Номер телефона" class="input">
                                </div>
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="Город" class="input">
                                </div>
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]" placeholder="ИНН"
                                        class="input">
                                </div>
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="Объем закупки в неделю (стебли)" class="input">
                                </div>
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="Торговое название компании" class="input">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-white">
                                <span>Стать дистрибьютором</span>
                            </button>
                        </form>
                        <div class="block-forms__image">
                            <img loading="lazy" src="img/image8.webp" alt="">
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>