<div id="request" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <img src="img/icons/close.svg" alt="">
            </div>
            <div class="block-forms">
                <div class="block-forms__content">
                    <form action="#" class="form">
                        <div class="form__top">
                            <h2 class="title2">
                                Отсавить заявку
                            </h2>
                            <p>
                                менеджер свяжется в течение 2 часов
                            </p>
                        </div>
                        <div class="form__inputs">
                            <div class="form__input">
                                <input data-required autocomplete="off" type="text" name="form[]" placeholder="Ваше имя"
                                    class="input">
                            </div>
                            <div class="form__input">
                                <input data-required autocomplete="off" type="text" name="form[]"
                                    placeholder="Ваш телефон" class="input">
                            </div>
                            <div class="form__input">
                                <input data-required autocomplete="off" type="text" name="form[]"
                                    placeholder="Ваш email" class="input">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-white">
                            <span>Отправить заявку</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>